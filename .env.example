# ═══════════════════════════════════════════════════════════════
#  k4-AiController — Environment Variables Reference
#  Copy this file to .env.local for development
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
#  DATABASE
# ───────────────────────────────────────────────────────────────
# Development (Docker Compose)
DATABASE_URL="postgresql://k4user:k4password_dev@localhost:5432/k4_aicontroller?schema=public"

# Production example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/k4_aicontroller?schema=public&sslmode=require"

# ───────────────────────────────────────────────────────────────
#  REDIS
# ───────────────────────────────────────────────────────────────
# Development (Docker Compose)
REDIS_URL="redis://:redis_dev_password@localhost:6379"

# Production example:
# REDIS_URL="rediss://:PASSWORD@HOST:6380"

# ───────────────────────────────────────────────────────────────
#  JWT TOKENS
# ───────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_64_BYTE_HEX_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_64_BYTE_HEX_REFRESH_SECRET"

# Token expiry
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ───────────────────────────────────────────────────────────────
#  ENCRYPTION (for CRM/telephony tokens at rest)
# ───────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 32 bytes (64 hex characters)
ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_BYTE_HEX_ENCRYPTION_KEY_64CHARS"

# ───────────────────────────────────────────────────────────────
#  S3-COMPATIBLE STORAGE
# ───────────────────────────────────────────────────────────────
# Development — MinIO (Docker Compose)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="k4-audio-recordings"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin_dev_password"
S3_FORCE_PATH_STYLE="true"

# Production — Cloudflare R2 example:
# S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="k4-audio-recordings"
# S3_ACCESS_KEY_ID="R2_ACCESS_KEY_ID"
# S3_SECRET_ACCESS_KEY="R2_SECRET_ACCESS_KEY"
# S3_FORCE_PATH_STYLE="false"

# AWS S3 example:
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_REGION="eu-central-1"
# S3_BUCKET="k4-audio-recordings"
# S3_ACCESS_KEY_ID="AWS_ACCESS_KEY_ID"
# S3_SECRET_ACCESS_KEY="AWS_SECRET_ACCESS_KEY"
# S3_FORCE_PATH_STYLE="false"

# Signed URL expiry in seconds (default: 900 = 15 minutes)
S3_SIGNED_URL_EXPIRES="900"

# ───────────────────────────────────────────────────────────────
#  AI PROVIDER — OPENAI
# ───────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-CHANGE_ME"

# Whisper model for speech-to-text
OPENAI_WHISPER_MODEL="whisper-1"

# GPT model for AI audit
OPENAI_AUDIT_MODEL="gpt-4o"

# ───────────────────────────────────────────────────────────────
#  amoCRM OAuth2 Integration
# ───────────────────────────────────────────────────────────────
# Create at: https://www.amocrm.ru/developers/content/oauth/step-by-step
AMOCRM_CLIENT_ID="CHANGE_ME"
AMOCRM_CLIENT_SECRET="CHANGE_ME"
# Must match exactly what's set in amoCRM app settings
AMOCRM_REDIRECT_URI="http://localhost:3000/api/integrations/amocrm/callback"

# ───────────────────────────────────────────────────────────────
#  OnlinePBX Integration
# ───────────────────────────────────────────────────────────────
ONLINEPBX_API_KEY="CHANGE_ME"
# Webhook secret for verifying OnlinePBX webhook signatures
ONLINEPBX_WEBHOOK_SECRET="CHANGE_ME"

# ───────────────────────────────────────────────────────────────
#  APPLICATION
# ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# App mode (development | demo | production)
# production: mock / seed data is strictly disabled.
APP_MODE="development"

# ───────────────────────────────────────────────────────────────
#  Super Admin Bootstrap (used only for first setup)
# ───────────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL="admin@marketingmarkazi.uz"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
BOOTSTRAP_ADMIN_NAME="Marketing Markazi Admin"
